{
  "name": "FreeRTOS-Kernel",
  "version": "11.1.0",
  "description": "FreeRTOS-Kernel V11.1.0, vendored subset: core + GCC/ARM_CM4F port + heap_4",
  "license": "MIT",
  "build": {
    "includeDir": "include",
    "srcFilter": [
      "+<*.c>",
      "+<portable/GCC/ARM_CM4F/port.c>",
      "+<portable/MemMang/heap_4.c>"
    ],
    "flags": [
      "-I portable/GCC/ARM_CM4F"
    ]
  }
}
