{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m4",
    "extra_flags": "-DSTM32F4 -DSTM32F407xx",
    "f_cpu": "168000000L",
    "mcu": "stm32f407zgt6",
    "product_line": "STM32F407xx",
    "stm32cube": {
      "custom_config_header": "yes"
    }
  },
  "connectivity": [
    "can"
  ],
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "onboard_tools": [
      "stlink"
    ],
    "jlink_device": "STM32F407ZG",
    "openocd_target": "stm32f4x",
    "svd_path": "STM32F40x.svd"
  },
  "frameworks": [
    "stm32cube"
  ],
  "name": "RT-Thread RT-Spark (STM32F407ZGT6, HW1.1)",
  "upload": {
    "maximum_ram_size": 131072,
    "maximum_size": 1048576,
    "protocol": "stlink",
    "protocols": [
      "stlink"
    ]
  },
  "url": "https://github.com/RT-Thread-Studio/sdk-bsp-stm32f407-spark",
  "vendor": "RT-Thread"
}
